{
  "manifest_version": 3,
  "name": "OpenNOW Chrome",
  "description": "Cliente de GeForce NOW para Chrome",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://play.geforcenow.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
